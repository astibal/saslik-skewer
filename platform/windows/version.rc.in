#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SKEWER_VERSION_COMMAS@
 PRODUCTVERSION @SKEWER_VERSION_COMMAS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Smithproxy\0"
            VALUE "FileDescription", "Skewer application routing client\0"
            VALUE "FileVersion", "@SKEWER_APP_VERSION@\0"
            VALUE "InternalName", "skewer\0"
            VALUE "OriginalFilename", "skewer.exe\0"
            VALUE "ProductName", "Skewer\0"
            VALUE "ProductVersion", "@SKEWER_APP_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
